# Copy this file to .env and fill in your key. .env is git-ignored; never commit it.
LLM_API_KEY=
# Optional backups, tried in order when a key is rate limited (429), overloaded, or times out (comma separated):
# LLM_API_KEYS=second_key,third_key
# Gemini (default):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-latest
# Groq instead:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<a Groq model id, e.g. from console.groq.com/docs/models>
