PREFIX : <https://example.org/wind-v1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?turbineName ?observedAt ?power ?sourceFile ?sourceRow ?eventMessage ?eventFile ?eventRow WHERE {
  ?observation sosa:hasFeatureOfInterest <https://example.org/wind-v1/turbine/KWF2> ;
    sosa:observedProperty :Power ; sosa:resultTime ?observedAt ;
    sosa:hasSimpleResult ?power ; :sourceFile ?sourceFile ; :sourceRow ?sourceRow .
  <https://example.org/wind-v1/turbine/KWF2> :name ?turbineName .
  <https://example.org/wind-v1/event/KWF2/72> :message ?eventMessage ; :sourceFile ?eventFile ; :sourceRow ?eventRow ;
    :startedAt ?eventStart ; :endedAt ?eventEnd .
  FILTER (?observedAt >= "2016-01-29T12:00:00Z"^^xsd:dateTime && ?observedAt < "2016-01-29T13:00:00Z"^^xsd:dateTime && ?observedAt >= ?eventStart && ?observedAt < ?eventEnd)
}
ORDER BY ?observedAt
LIMIT 5
