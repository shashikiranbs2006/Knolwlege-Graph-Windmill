    ];
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:template "https://example.org/wind-v1/instant/event/{turbine_id}/{row_number}/start";
          rr:termType rr:IRI
        ];
      rr:predicate time:hasBeginning
    ] .

<urn:r2rml:event_start_instants-4d3e090d-3aed-4513-9c30-fe2588982309> a rr:TriplesMap;
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery "SELECT turbine_id, row_number, started_at FROM status_events"
    ];
  rr:subjectMap [ a rr:SubjectMap, rr:TermMap;
      rr:template "https://example.org/wind-v1/instant/event/{turbine_id}/{row_number}/start";
      rr:class time:Instant;
      rr:termType rr:IRI
    ];
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:column "started_at";
          rr:termType rr:Literal;
          rr:datatype xsd:dateTimeStamp
        ];
      rr:predicate time:inXSDDateTimeStamp
    ] .

<urn:r2rml:synthetic_components-3c190eee-2428-465a-81e0-0f1a481f69fb> a rr:TriplesMap;
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
