          rr:template "https://example.org/wind-v1/component/{turbine_id}/{proposed_component}";
          rr:termType rr:IRI
        ]
    ] .

<urn:r2rml:synthetic_faults-7c06d756-135a-4627-b327-f250f62d5de6> a rr:TriplesMap;
  rr:subjectMap [ a rr:SubjectMap, rr:TermMap;
      rr:class :FaultCondition;
      rr:template "https://example.org/wind-v1/fault/{case_id}";
      rr:termType rr:IRI
    ];
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery "SELECT case_id, turbine_id, source_status_row, proposed_fault, proposed_component, record_kind, relation_confidence, evidence_note, dataset_id FROM synthetic_maintenance"
    ];
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:predicate :name;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:column "proposed_fault";
          rr:termType rr:Literal
        ]
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:termType rr:Literal;
          rr:column "record_kind"
        ];
      rr:predicate :recordKind
    ], [ a rr:PredicateObjectMap;
      rr:predicate :confidence;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:datatype xsd:decimal;
          rr:termType rr:Literal;
          rr:column "relation_confidence"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "evidence_note";
          rr:termType rr:Literal
        ];
      rr:predicate :evidenceNote
    ], [ a rr:PredicateObjectMap;
      rr:predicate :affectsComponent;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:IRI;
          rr:template "https://example.org/wind-v1/component/{turbine_id}/{proposed_component}"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate prov:wasDerivedFrom;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:template "https://example.org/wind-v1/dataset/{dataset_id}";
          rr:termType rr:IRI
        ]
    ] .

<urn:r2rml:synthetic_faults-ce2f247b-9aa7-46cc-906f-c0f612bd0d3e> a rr:TriplesMap;
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:IRI;
          rr:template "https://example.org/wind-v1/fault/{case_id}"
        ];
