@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix : <https://example.org/wind-v1/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix obda: <https://w3id.org/obda/vocabulary#> .

<urn:r2rml:datasets> a rr:TriplesMap;
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery "SELECT * FROM datasets"
    ];
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "usage_note";
          rr:termType rr:Literal
        ];
      rr:predicate :note
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:Literal;
          rr:column "license"
        ];
      rr:predicate :license
    ], [ a rr:PredicateObjectMap;
      rr:predicate :ownedBy;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:column "owner";
          rr:termType rr:Literal
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate :recordKind;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:Literal;
          rr:column "record_kind"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:termType rr:Literal;
          rr:column "source"
        ];
      rr:predicate :source
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:Literal;
          rr:column "source_date";
          rr:datatype xsd:date
        ];
      rr:predicate :sourceDate
    ];
  rr:subjectMap [ a rr:TermMap, rr:SubjectMap;
      rr:template "https://example.org/wind-v1/dataset/{dataset_id}";
      rr:class :Dataset;
      rr:termType rr:IRI
    ] .

<urn:r2rml:site> a rr:TriplesMap;
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:object "Kelmarsh";
      rr:predicate :name
    ];
  rr:subject <https://example.org/wind-v1/site/Kelmarsh>;
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery "SELECT turbine_id FROM turbines WHERE turbine_id = 'KWF1'"
    ] .

<urn:r2rml:turbines> a rr:TriplesMap;
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "title";
          rr:termType rr:Literal
        ];
      rr:predicate :name
    ], [ a rr:PredicateObjectMap;
      rr:object <https://example.org/wind-v1/site/Kelmarsh>;
      rr:predicate :locatedAt
    ], [ a rr:PredicateObjectMap;
      rr:predicate prov:wasDerivedFrom;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:template "https://example.org/wind-v1/dataset/{dataset_id}";
          rr:termType rr:IRI
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate :recordKind;
      rr:object "observed_source"
    ];
  rr:subjectMap [ a rr:TermMap, rr:SubjectMap;
      rr:class :WindTurbine;
      rr:termType rr:IRI;
      rr:template "https://example.org/wind-v1/turbine/{turbine_id}"
    ];
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery "SELECT turbine_id, title, dataset_id FROM turbines"
    ] .

<urn:r2rml:streams> a rr:TriplesMap;
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:predicate :forTurbine;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:IRI;
          rr:template "https://example.org/wind-v1/turbine/{turbine_id}"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate prov:wasDerivedFrom;
      rr:object <https://example.org/wind-v1/dataset/kelmarsh-2016>
    ];
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery "SELECT turbine_id FROM turbines"
    ];
  rr:subjectMap [ a rr:TermMap, rr:SubjectMap;
      rr:class :SCADADataStream;
      rr:termType rr:IRI;
      rr:template "https://example.org/wind-v1/stream/{turbine_id}"
    ] .

<urn:r2rml:sensors> a rr:TriplesMap;
  rr:subjectMap [ a rr:SubjectMap, rr:TermMap;
      rr:class :Sensor;
      rr:termType rr:IRI;
      rr:template "https://example.org/wind-v1/sensor/{turbine_id}/{signal}"
    ];
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:predicate sosa:observes;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:template "https://example.org/wind-v1/{signal}";
          rr:termType rr:IRI
        ]
    ];
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery "SELECT turbine_id, signal FROM logical_sensors"
    ] .

<urn:r2rml:observations> a rr:TriplesMap;
  rr:subjectMap [ a rr:TermMap, rr:SubjectMap;
      rr:template "https://example.org/wind-v1/observation/{turbine_id}/{row_number}/{signal}";
      rr:class sosa:Observation;
      rr:termType rr:IRI
    ];
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:predicate sosa:hasFeatureOfInterest;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:termType rr:IRI;
          rr:template "https://example.org/wind-v1/turbine/{turbine_id}"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate :recordKind;
      rr:object "observed_source"
    ], [ a rr:PredicateObjectMap;
      rr:predicate :sourceFile;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:Literal;
          rr:column "source_file"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate :sourceRow;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:termType rr:Literal;
          rr:datatype xsd:integer;
          rr:column "row_number"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:IRI;
          rr:template "https://example.org/wind-v1/dataset/{dataset_id}"
        ];
      rr:predicate prov:wasDerivedFrom
    ], [ a rr:PredicateObjectMap;
      rr:predicate sosa:resultTime;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:Literal;
          rr:datatype xsd:dateTime;
          rr:column "observed_at"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate sosa:hasSimpleResult;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:termType rr:Literal;
          rr:datatype xsd:double;
          rr:column "value"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate sosa:madeBySensor;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:IRI;
          rr:template "https://example.org/wind-v1/sensor/{turbine_id}/{signal}"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:IRI;
          rr:template "https://example.org/wind-v1/{signal}"
        ];
      rr:predicate sosa:observedProperty
    ], [ a rr:PredicateObjectMap;
      rr:predicate :signal;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:column "signal";
          rr:termType rr:Literal
        ]
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:template "http://qudt.org/vocab/unit/{unit_code}";
          rr:termType rr:IRI
        ];
      rr:predicate :unit
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:IRI;
          rr:template "https://example.org/wind-v1/stream/{turbine_id}"
        ];
      rr:predicate :fromStream
    ];
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery "SELECT source_file, row_number, turbine_id, observed_at, signal, unit_code, value, dataset_id FROM measurement_observations"
    ] .

<urn:r2rml:performance> a rr:TriplesMap;
  rr:subjectMap [ a rr:SubjectMap, rr:TermMap;
      rr:class :PerformanceMetric;
      rr:template "https://example.org/wind-v1/observation/{turbine_id}/{row_number}/{signal}";
      rr:termType rr:IRI
    ];
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery "SELECT turbine_id, row_number, signal FROM measurement_observations WHERE signal IN ('Power', 'EnergyExport')"
    ] .

<urn:r2rml:environment> a rr:TriplesMap;
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery "SELECT turbine_id, row_number, signal FROM measurement_observations WHERE signal = 'WindSpeed'"
    ];
  rr:subjectMap [ a rr:SubjectMap, rr:TermMap;
      rr:template "https://example.org/wind-v1/observation/{turbine_id}/{row_number}/{signal}";
      rr:termType rr:IRI;
      rr:class :EnvironmentalCondition
    ] .

<urn:r2rml:events> a rr:TriplesMap;
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:predicate :code;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:column "code";
          rr:termType rr:Literal
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate :endedAt;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "ended_at";
          rr:datatype xsd:dateTime;
          rr:termType rr:Literal
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate :startedAt;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:column "started_at";
          rr:datatype xsd:dateTime;
          rr:termType rr:Literal
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate :message;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:Literal;
          rr:column "message"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:template "https://example.org/wind-v1/turbine/{turbine_id}";
          rr:termType rr:IRI
        ];
      rr:predicate sosa:hasFeatureOfInterest
    ], [ a rr:PredicateObjectMap;
      rr:predicate prov:wasDerivedFrom;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:IRI;
          rr:template "https://example.org/wind-v1/dataset/{dataset_id}"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate :recordKind;
      rr:object "observed_source"
    ], [ a rr:PredicateObjectMap;
      rr:predicate :sourceFile;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:termType rr:Literal;
          rr:column "source_file"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate :sourceRow;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:datatype xsd:integer;
          rr:column "row_number";
          rr:termType rr:Literal
        ]
    ];
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery "SELECT source_file, row_number, turbine_id, started_at, ended_at, message, code, dataset_id FROM status_events"
    ];
  rr:subjectMap [ a rr:TermMap, rr:SubjectMap;
      rr:class :OperationalEvent;
      rr:template "https://example.org/wind-v1/event/{turbine_id}/{row_number}";
      rr:termType rr:IRI
    ] .

<urn:r2rml:event_start_instants-68bba27d-ea0b-4ec2-9366-8f14de6aafb2> a rr:TriplesMap;
  rr:subjectMap [ a rr:TermMap, rr:SubjectMap;
      rr:termType rr:IRI;
      rr:template "https://example.org/wind-v1/event/{turbine_id}/{row_number}"
    ];
  rr:logicalTable [ a rr:R2RMLView;
