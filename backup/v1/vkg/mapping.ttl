    ] .

<urn:r2rml:synthetic_components-f80b6d58-4280-436c-ba15-a01f62b15216> a rr:TriplesMap;
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery "SELECT turbine_id, proposed_component, dataset_id FROM synthetic_maintenance"
    ];
  rr:subjectMap [ a rr:TermMap, rr:SubjectMap;
