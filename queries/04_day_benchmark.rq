PREFIX wind: <https://w3id.org/wind-core/ontology#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT (COUNT(?observation) AS ?readings) WHERE {
  ?observation sosa:hasFeatureOfInterest <https://w3id.org/wind-core/data/farm/kelmarsh/turbine/KWF2> ;
    sosa:observedProperty wind:Power ; sosa:resultTime ?observedAt .
  FILTER (?observedAt >= "2016-01-29T00:00:00Z"^^xsd:dateTime && ?observedAt < "2016-01-30T00:00:00Z"^^xsd:dateTime)
}
