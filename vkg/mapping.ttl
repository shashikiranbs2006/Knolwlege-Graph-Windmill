    ];
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery "SELECT fault_code, label, description, component_type, dataset_id FROM fault_conditions"
    ] .

<urn:r2rml:diagnoses-86c8786d-ec5d-4553-bafc-e356e9f1ff94> a rr:TriplesMap;
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:predicate wind:diagnosedFault;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:template "https://w3id.org/wind-core/data/fault/{fault_code}";
          rr:termType rr:IRI
        ]
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:template "https://w3id.org/wind-core/data/farm/{farm_id}/turbine/{turbine_id}/event/{row_number}";
          rr:termType rr:IRI
        ];
      rr:predicate wind:diagnosedEvent
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:column "rationale";
          rr:termType rr:Literal
