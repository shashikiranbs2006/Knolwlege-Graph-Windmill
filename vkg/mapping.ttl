      rr:termType rr:IRI
    ] .

<urn:r2rml:event_start_instants-0a71d97d-9a5c-444b-8a08-2794611c4dc9> a rr:TriplesMap;
  rr:logicalTable [ a rr:R2RMLView;
      rr:sqlQuery "SELECT e.turbine_id, t.farm_id, e.row_number, e.started_at FROM status_events e JOIN turbines t ON t.turbine_id = e.turbine_id"
    ];
  rr:subjectMap [ a rr:TermMap, rr:SubjectMap;
