    ] .

<urn:r2rml:fault_conditions> a rr:TriplesMap;
  rr:predicateObjectMap [ a rr:PredicateObjectMap;
      rr:predicate skos:prefLabel;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:column "label";
          rr:termType rr:Literal
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate wind:name;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:termType rr:Literal;
          rr:column "label"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:predicate prov:wasDerivedFrom;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
          rr:termType rr:IRI;
          rr:template "https://w3id.org/wind-core/data/dataset/{dataset_id}"
        ]
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:TermMap, rr:ObjectMap;
          rr:column "description";
          rr:termType rr:Literal
        ];
      rr:predicate skos:definition
    ], [ a rr:PredicateObjectMap;
      rr:objectMap [ a rr:ObjectMap, rr:TermMap;
